# Port the HTTP server listens on.
PORT=8080

# API key for the Gemini API, used by the LLM tutor service to generate replies.
# Get one at https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model used to generate tutor replies. Defaults to gemini-flash-latest if unset,
# a generation-agnostic alias Google keeps pointed at a current flash model, avoiding the
# 404s that come from pinning to a dated model ID (e.g. gemini-1.5-flash) that gets retired.
# Override this without a redeploy if the configured model stops working.
GEMINI_MODEL=gemini-flash-latest
