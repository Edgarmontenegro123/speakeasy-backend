# Port the HTTP server listens on.
PORT=8080

# API key for the Gemini API, used by the LLM tutor service to generate replies.
# Get one at https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model used to generate tutor replies. Defaults to gemini-2.5-flash if unset.
# Google periodically retires older model IDs (e.g. gemini-1.5-flash, gemini-1.5-pro
# return 404) — override this without a redeploy if the configured model stops working.
GEMINI_MODEL=gemini-2.5-flash
